{
  "name": "netix-frontend",
  "version": "1.0.3",
  "description": "NETIX shared frontend library: API client, hooks, utils, i18n, UI components and design tokens",
  "license": "AGPL-3.0-only",
  "author": "NETIX.AI OSS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NETIX-AI-OSS/netix-frontend.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "presets"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./api": {
      "react-native": {
        "types": "./dist/api.d.cts",
        "default": "./dist/api.cjs"
      },
      "import": {
        "types": "./dist/api.d.ts",
        "default": "./dist/api.js"
      },
      "require": {
        "types": "./dist/api.d.cts",
        "default": "./dist/api.cjs"
      }
    },
    "./hooks": {
      "react-native": {
        "types": "./dist/hooks.d.cts",
        "default": "./dist/hooks.cjs"
      },
      "import": {
        "types": "./dist/hooks.d.ts",
        "default": "./dist/hooks.js"
      },
      "require": {
        "types": "./dist/hooks.d.cts",
        "default": "./dist/hooks.cjs"
      }
    },
    "./hooks/router": {
      "import": {
        "types": "./dist/hooks/router.d.ts",
        "default": "./dist/hooks/router.js"
      }
    },
    "./utils": {
      "react-native": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      },
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./i18n": {
      "react-native": {
        "types": "./dist/i18n.d.cts",
        "default": "./dist/i18n.cjs"
      },
      "import": {
        "types": "./dist/i18n.d.ts",
        "default": "./dist/i18n.js"
      },
      "require": {
        "types": "./dist/i18n.d.cts",
        "default": "./dist/i18n.cjs"
      }
    },
    "./utils/dom": {
      "import": {
        "types": "./dist/utils/dom.d.ts",
        "default": "./dist/utils/dom.js"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui.d.ts",
        "default": "./dist/ui.js"
      }
    },
    "./ui/styles.css": "./dist/ui/styles.css",
    "./ui/styles-notokens.css": "./dist/ui/styles-notokens.css",
    "./ui/*": {
      "import": {
        "types": "./dist/ui/*.d.ts",
        "default": "./dist/ui/*.js"
      }
    },
    "./tokens/tokens.css": "./dist/tokens/tokens.css",
    "./tokens/theme-only.css": "./dist/tokens/theme-only.css",
    "./tokens/vars.css": "./dist/tokens/vars.css",
    "./tokens/preset": "./dist/tokens/preset.cjs",
    "./tokens/theme-init.js": "./dist/tokens/theme-init.js",
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "require": {
        "types": "./dist/tokens.d.cts",
        "default": "./dist/tokens.cjs"
      }
    },
    "./fonts/*": "./dist/fonts/*",
    "./presets/eslint": "./presets/eslint.mjs",
    "./presets/eslint-strict": "./presets/eslint-strict.mjs",
    "./presets/tsconfig": "./presets/tsconfig.json",
    "./presets/prettier": "./presets/prettier.json",
    "./presets/*": "./presets/*"
  },
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "gen:tokens:check": "node scripts/gen-tokens.mjs --check",
    "build:js": "tsup",
    "build:css": "tailwindcss -i src/ui/styles.css -o dist/ui/styles.css --minify && tailwindcss -i src/ui/styles-notokens.css -o dist/ui/styles-notokens.css --minify",
    "build": "rm -rf dist && pnpm gen:tokens && pnpm build:js && pnpm build:css",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
