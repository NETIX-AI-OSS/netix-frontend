{
  "name": "netix-frontend",
  "version": "2.2.1",
  "description": "NETIX frontend platform: the importable runtime contract (api, tokens, theme, i18n, utils, presets), the @netix component registry, and the netix scaffolding CLI",
  "license": "AGPL-3.0-only",
  "author": "NETIX.AI OSS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NETIX-AI-OSS/netix-frontend.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "netix": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "presets",
    "services.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./api": {
      "react-native": {
        "types": "./dist/api.native.d.cts",
        "default": "./dist/api.native.cjs"
      },
      "import": {
        "types": "./dist/api.d.ts",
        "default": "./dist/api.js"
      },
      "require": {
        "types": "./dist/api.d.cts",
        "default": "./dist/api.cjs"
      }
    },
    "./api/auth-config": {
      "react-native": {
        "types": "./dist/api/auth-config.d.cts",
        "default": "./dist/api/auth-config.cjs"
      },
      "import": {
        "types": "./dist/api/auth-config.d.ts",
        "default": "./dist/api/auth-config.js"
      },
      "require": {
        "types": "./dist/api/auth-config.d.cts",
        "default": "./dist/api/auth-config.cjs"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/auth.d.ts",
        "default": "./dist/auth.js"
      },
      "require": {
        "types": "./dist/auth.d.cts",
        "default": "./dist/auth.cjs"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/hooks.d.ts",
        "default": "./dist/hooks.js"
      },
      "require": {
        "types": "./dist/hooks.d.cts",
        "default": "./dist/hooks.cjs"
      }
    },
    "./hooks/permissions": {
      "react-native": {
        "types": "./dist/hooks/permissions.d.cts",
        "default": "./dist/hooks/permissions.cjs"
      },
      "import": {
        "types": "./dist/hooks/permissions.d.ts",
        "default": "./dist/hooks/permissions.js"
      },
      "require": {
        "types": "./dist/hooks/permissions.d.cts",
        "default": "./dist/hooks/permissions.cjs"
      }
    },
    "./utils": {
      "react-native": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      },
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./i18n": {
      "react-native": {
        "types": "./dist/i18n.d.cts",
        "default": "./dist/i18n.cjs"
      },
      "import": {
        "types": "./dist/i18n.d.ts",
        "default": "./dist/i18n.js"
      },
      "require": {
        "types": "./dist/i18n.d.cts",
        "default": "./dist/i18n.cjs"
      }
    },
    "./utils/dom": {
      "import": {
        "types": "./dist/utils/dom.d.ts",
        "default": "./dist/utils/dom.js"
      }
    },
    "./theme": {
      "import": {
        "types": "./dist/theme.d.ts",
        "default": "./dist/theme.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens/tokens.css",
    "./theme-init.js": "./dist/tokens/theme-init.js",
    "./tokens/tokens.css": "./dist/tokens/tokens.css",
    "./tokens/theme-only.css": "./dist/tokens/theme-only.css",
    "./tokens/vars.css": "./dist/tokens/vars.css",
    "./tokens/preset": "./dist/tokens/preset.cjs",
    "./tokens/theme-init.js": "./dist/tokens/theme-init.js",
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "require": {
        "types": "./dist/tokens.d.cts",
        "default": "./dist/tokens.cjs"
      }
    },
    "./fonts/*": "./dist/fonts/*",
    "./services.json": "./services.json",
    "./presets/eslint": "./presets/eslint.mjs",
    "./presets/eslint-strict": "./presets/eslint-strict.mjs",
    "./presets/tsconfig": "./presets/tsconfig.json",
    "./presets/prettier": "./presets/prettier.json",
    "./presets/*": "./presets/*"
  },
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "gen:tokens:check": "node scripts/gen-tokens.mjs --check",
    "build:js": "tsup",
    "build": "rm -rf dist && pnpm gen:tokens && pnpm build:js",
    "registry:build": "shadcn build registry.json --output r",
    "sync:template": "node scripts/sync-template-components.mjs",
    "sync:template:check": "node scripts/sync-template-components.mjs --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.19.0",
    "envoy-ts-auth": "*",
    "i18next": ">=25.7.0 <27",
    "react": ">=19.1.0 <20",
    "react-dom": ">=19.1.0 <20",
    "react-i18next": ">=15.7.0 <18",
    "swr": "^2.5.1"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "axios": {
      "optional": true
    },
    "envoy-ts-auth": {
      "optional": true
    },
    "i18next": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    },
    "swr": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@clack/prompts": "^1.8.1",
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-table": "^9.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "i18next": "^26.7.1",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.67.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.12",
    "react-router": "^8.5.1",
    "shadcn": "4.23.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
