{
  "name": "netix-frontend",
  "version": "0.0.0",
  "description": "NETIX shared frontend library: API client, hooks, utils, i18n, UI components and design tokens",
  "license": "AGPL-3.0-only",
  "author": "NETIX.AI OSS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NETIX-AI-OSS/netix-frontend.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "files": [
    "dist",
    "presets"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./api": {
      "react-native": {
        "types": "./dist/api.d.cts",
        "default": "./dist/api.cjs"
      },
      "import": {
        "types": "./dist/api.d.ts",
        "default": "./dist/api.js"
      },
      "require": {
        "types": "./dist/api.d.cts",
        "default": "./dist/api.cjs"
      }
    },
    "./hooks": {
      "react-native": {
        "types": "./dist/hooks.d.cts",
        "default": "./dist/hooks.cjs"
      },
      "import": {
        "types": "./dist/hooks.d.ts",
        "default": "./dist/hooks.js"
      },
      "require": {
        "types": "./dist/hooks.d.cts",
        "default": "./dist/hooks.cjs"
      }
    },
    "./utils": {
      "react-native": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      },
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./i18n": {
      "react-native": {
        "types": "./dist/i18n.d.cts",
        "default": "./dist/i18n.cjs"
      },
      "import": {
        "types": "./dist/i18n.d.ts",
        "default": "./dist/i18n.js"
      },
      "require": {
        "types": "./dist/i18n.d.cts",
        "default": "./dist/i18n.cjs"
      }
    },
    "./utils/dom": {
      "import": {
        "types": "./dist/utils/dom.d.ts",
        "default": "./dist/utils/dom.js"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui.d.ts",
        "default": "./dist/ui.js"
      }
    },
    "./ui/styles.css": "./dist/ui/styles.css",
    "./tokens/tokens.css": "./dist/tokens/tokens.css",
    "./tokens/vars.css": "./dist/tokens/vars.css",
    "./tokens/preset": "./dist/tokens/preset.cjs",
    "./tokens/theme-init.js": "./dist/tokens/theme-init.js",
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "require": {
        "types": "./dist/tokens.d.cts",
        "default": "./dist/tokens.cjs"
      }
    },
    "./fonts/*": "./dist/fonts/*",
    "./presets/*": "./presets/*"
  },
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "gen:tokens:check": "node scripts/gen-tokens.mjs --check",
    "build:js": "tsup",
    "build:css": "tailwindcss -i src/ui/styles.css -o dist/ui/styles.css --minify",
    "build": "pnpm gen:tokens && pnpm build:js && pnpm build:css",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "react": ">=19.1.0 <20"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-table": "^9.1.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "i18next": "^26.4.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.34.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.12",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
