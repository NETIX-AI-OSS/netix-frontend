{
  "$comment": "Canonical NETIX service manifest: which backend repo publishes each OpenAPI spec, where it lives, and the app-side wiring conventions. Consumed by the netix CLI (init, schema pull) and exported as netix-frontend/services.json.",
  "services": {
    "data": {
      "title": "Data Service",
      "backendRepo": "4T5Labs/data-service",
      "specPath": "openapi/schema-data.yaml",
      "localPort": 8009,
      "envVar": "VITE_DATA_SERVICE_BASE_URL",
      "apiSubdomain": "data.api"
    },
    "cafm": {
      "title": "CAFM",
      "backendRepo": "4T5Labs/cafm-backend",
      "specPath": "openapi/schema-cafm.yaml",
      "localPort": 8000,
      "envVar": "VITE_CAFM_SERVICE_BASE_URL",
      "apiSubdomain": "cafm.api"
    },
    "asset": {
      "title": "Asset Management",
      "backendRepo": "4T5Labs/asset-service",
      "specPath": "openapi/schema-asset.yaml",
      "localPort": 8003,
      "envVar": "VITE_ASSET_SERVICE_BASE_URL",
      "apiSubdomain": "asset.api"
    },
    "user": {
      "title": "User Management",
      "backendRepo": "NETIX-AI/user-management",
      "specPath": "openapi/schema-user-management.yaml",
      "localPort": 8001,
      "envVar": "VITE_USER_SERVICE_BASE_URL",
      "apiSubdomain": "user.api"
    },
    "notification": {
      "title": "Notifications",
      "backendRepo": "4T5Labs/notification-service",
      "specPath": "openapi/schema-notification.yaml",
      "localPort": 8002,
      "envVar": "VITE_NOTIFICATION_SERVICE_BASE_URL",
      "apiSubdomain": "notification.api"
    }
  }
}
