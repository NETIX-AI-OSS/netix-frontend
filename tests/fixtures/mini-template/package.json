{
  "name": "cookie-cutter-ui",
  "description": "NETIX React template with local Base UI components and a shared Tailwind v4 design foundation.",
  "author": "Ashish Kapoor",
  "private": true,
  "license": "MIT",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:client": "orval --config ./orval.config.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:design-system": "node scripts/check-design-system.mjs",
    "sync:theme-init": "node scripts/sync-theme-init.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "envoy-ts-auth": "github:NETIX-AI-OSS/envoy-ts-auth#113deae2e9b57c2621a9d8d14bf9f027151bc61c",
    "i18next": "^26.4.0",
    "lucide-react": "^1.34.0",
    "netix-frontend": "github:NETIX-AI-OSS/netix-frontend",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.12",
    "react-router": "^8.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "orval": "8.26.0",
    "prettier": "^3.9.6",
    "shadcn": "4.19.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.8.0",
  "prettier": "netix-frontend/presets/prettier.json"
}
