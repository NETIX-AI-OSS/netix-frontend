{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals"],
    "paths": {
      "@/components/ui/*": ["./registry/_fixtures/components/ui/*"],
      "@/lib/utils": ["./registry/_fixtures/lib/utils"],
      "@/hooks/*": ["./registry/netix/hooks/*"],
      "netix-frontend/api": ["./src/api/index.ts"],
      "netix-frontend/i18n": ["./src/i18n/index.ts"],
      "netix-frontend/theme": ["./src/theme/index.ts"],
      "netix-frontend/tokens": ["./src/tokens/index.ts"],
      "netix-frontend/utils": ["./src/utils/index.ts"]
    }
  },
  "include": ["src", "scripts", "presets", "registry", "*.ts"],
  "exclude": ["registry/netix/blocks"]
}
