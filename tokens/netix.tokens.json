{
  "$meta": {
    "version": 2,
    "encoding": "css-color",
    "brand": "#196796",
    "note": "Hand-edited source of truth (Nova design system). Run `pnpm gen:tokens` after every change."
  },
  "font": {
    "family": "Archivo",
    "dir": "../fonts",
    "faces": [
      { "file": "archivo-400.woff2", "weight": "400", "style": "normal" },
