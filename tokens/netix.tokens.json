      "tokens": {
        "skeleton-base": { "light": "#e1e6ea", "dark": "#2c333f" },
        "skeleton-highlight": {
          "light": "hsl(0 0% 100% / 0.7)",
          "dark": "hsl(210 40% 98% / 0.14)"
