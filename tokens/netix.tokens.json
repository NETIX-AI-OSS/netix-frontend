      }
    },
    {
      "name": "Shadows + motion",
      "tokens": {
        "shadow-sm": "0 1px 2px rgb(15 23 42 / 0.06)",
        "shadow-md": "0 8px 24px rgb(15 23 42 / 0.08)",
        "shadow-lg": "0 18px 44px rgb(15 23 42 / 0.12)",
